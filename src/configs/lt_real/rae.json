{
  "dataset": {
    "shuffle_train": true,
    "shuffle_eval": false,
    "random_start": true,
    "img_size": [
      224,
      224
    ],
    "step_size": 1,
    "dataset_name": "LanguageTable-Real",
    "root": "datasets/lt_real"
  },
  "model": {
    "predictor": {
      "predictor_name": "DFoT-VAE",
      "DFoT-VAE": {
        "input_size": 16,
        "patch_size": 1,
        "in_channels": 768,
        "model_hidden_size": 768,
        "num_blocks": 12,
        "num_heads": 8,
        "mlp_ratio": 4.0,
        "text_dropout_prob": 0.1,
        "learn_sigma": false,
        "buffer_size": 10,
        "use_ema": true,
        "load_ema": true,
        "layer_norm_ca": true,
        "pooling": false,
        "zero_init": false,
        "use_rope": true,
        "adaln_cross_attention": true,
        "use_temp_attn_layers": false,
        "text_encoder_params": {
          "model_name": "t5-small",
          "hidden_size": 512,
          "token_max_length": 20,
          "use_text_preprocessing": false
        },
        "diffusion_params": {
          "timestep_respacing": "",
          "noise_schedule": "cosine",
          "use_kl": false,
          "sigma_small": false,
          "predict_xstart": false,
          "rescale_learned_sigmas": false,
          "diffusion_steps": 1000
        }
      }
    }
  },
  "representation": {
    "type": "rae",
    "decoder_config": "src/rae/configs/decoder/ViTB",
    "decoder_checkpoint": "checkpoints/lt_real/rae_decoder.pt",
    "stats": "checkpoints/rae_stats.pt"
  },
  "training_prediction": {
    "lr": 0.0001
  }
}
